#!/bin/bash
DEV="/dev/video0"

# Turn off auto controls
#                   auto_exposure 0x009a0901 (menu)   : min=0 max=3 default=3 value=1 (Manual Mode)
v4l2-ctl -d $DEV --set-ctrl=auto_exposure=1
#         white_balance_automatic 0x0098090c (bool)   : default=1 value=0
v4l2-ctl -d $DEV --set-ctrl=white_balance_automatic=0
# v4l2-ctl -d $DEV --set-ctrl=focus_auto=0
#      exposure_dynamic_framerate 0x009a0903 (bool)   : default=0 value=1
v4l2-ctl -d $DEV --set-ctrl=exposure_dynamic_framerate=0

# Set static values
#          exposure_time_absolute 0x009a0902 (int)    : min=2 max=1250 step=1 default=156 value=570 flags=has-min-max
v4l2-ctl -d $DEV --set-ctrl=exposure_time_absolute=500
#       white_balance_temperature 0x0098091a (int)    : min=2800 max=6500 step=10 default=4600 value=2940 flags=has-min-max
v4l2-ctl -d $DEV --set-ctrl=white_balance_temperature=2800
# v4l2-ctl -d $DEV --set-ctrl=focus_absolute=40

#
#                      brightness 0x00980900 (int)    : min=0 max=255 step=1 default=128 value=128 flags=has-min-max
#                        contrast 0x00980901 (int)    : min=0 max=100 step=1 default=32 value=32 flags=has-min-max
#                      saturation 0x00980902 (int)    : min=0 max=100 step=1 default=64 value=64 flags=has-min-max
#                             hue 0x00980903 (int)    : min=-180 max=180 step=1 default=0 value=0 flags=has-min-max
#                           gamma 0x00980910 (int)    : min=90 max=150 step=1 default=120 value=122 flags=has-min-max
#            power_line_frequency 0x00980918 (menu)   : min=0 max=3 default=3 value=2 (60 Hz)
#                       sharpness 0x0098091b (int)    : min=0 max=7 step=1 default=3 value=3 flags=has-min-max
#          backlight_compensation 0x0098091c (int)    : min=0 max=2 step=1 default=1 value=0 flags=has-min-max
#    region_of_interest_rectangle 0x00981ae1 (rect)   : value=(0,0)/1x1 flags=has-payload, has-min-max
#   region_of_interest_auto_ctrls 0x00981ae2 (bitmask): max=0x00000009 default=0x00000009 value=0x00000000 flags=has-min-max
